NODE_ENV=development

# --- BASE DE DATOS ---
# SQLite: un solo archivo, sin servidor de base de datos aparte. En Docker
# apunta al volumen montado en docker-compose.yml para que persista entre
# reinicios del contenedor.
DATABASE_PATH=/app/data/camaras.db

# --- PUERTO DE LA API ---
PORT=3001

# --- SEGURIDAD Y SESIÓN ---
# Generá un valor propio y largo, no uses el de ejemplo.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES=8h

# --- GOOGLE OAUTH (pendiente, ver ESPECIFICACION.md sección 9) ---
# Client ID de un proyecto de Google Cloud con la pantalla de consentimiento
# restringida al dominio institucional. Mientras no esté seteado, el login
# real con Google responde 501 (no configurado).
GOOGLE_CLIENT_ID=
# Dominio institucional al que se restringe el login (claim "hd" de Google).
GOOGLE_HOSTED_DOMAIN=

# --- LOGIN DE DESARROLLO (solo si NODE_ENV != production) ---
# Permite loguearse como cualquier usuario ya cargado en la tabla `usuarios`
# sin pasar por Google, para poder desarrollar antes de tener credenciales
# OAuth. Se ignora completamente en producción, pase lo que pase acá.
ALLOW_DEV_LOGIN=true

# --- RED LOCAL ---
# Rango(s) de IP de la LAN del hospital, separados por coma (ej:
# "192.168.8.0/24,192.168.9.0/24" si hay más de una VLAN de clientes). Fuera
# de este rango, el backend responde 403 a cualquier pedido. Vacío = sin
# restricción (para desarrollo local).
LAN_CIDR=

# --- LOGIN INSTITUCIONAL POR CÓDIGO (alternativa a Google, ver auth.js) ---
# Servidor SMTP para mandar el código de acceso por email. Sin SMTP_HOST, el
# código se imprime en el log del backend en vez de mandarse (útil para
# probar el flujo antes de tener un SMTP institucional configurado).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- CORS ---
# Opcional. Orígenes permitidos separados por coma (ej: http://localhost:5173).
# Si se deja vacío, el backend acepta cualquier origen.
CORS_ORIGIN=

# --- ALTA DEL PRIMER ADMIN ---
# Se corre una sola vez al levantar el contenedor (src/seedAdmin.js): si este
# email ya existe en `usuarios` no hace nada, así que es seguro dejarlo
# seteado permanentemente. Es la única alta de usuario que no pasa por la API,
# porque el endpoint POST /api/usuarios ya requiere rol admin para usarse.
ADMIN_EMAIL=
ADMIN_NOMBRE=
